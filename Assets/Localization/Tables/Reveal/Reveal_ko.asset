      - rid: 7751032784689562415
  - m_Id: 9920074
    m_Localized: "\uBAA9\uD45C {target} \uBBF8\uB2EC \u2014 \uC138 \uBC88\uC9F8 \uC2A4\uD2B8\uB77C\uC774\uD06C\uAC00
